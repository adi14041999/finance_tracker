# Copy this file to .env.local and fill in the two values below.
# .env.local is gitignored, so your credentials never reach GitHub.
#
# Until both are set, the app runs on built-in sample data — everything works,
# the numbers are just made up. There is no error state to get stuck in.

# 1. The sheet ID: the part of the sheet's URL between /d/ and /edit
#    https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# 2. The service account credentials.
#    Open the JSON key file you downloaded from Google Cloud and copy the
#    values of "client_email" and "private_key" out of it.
#
#    The private key MUST stay on one line with literal \n sequences, exactly
#    as it appears in the JSON file, and MUST be wrapped in double quotes.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternatively, paste the entire JSON file contents on one line here and
# leave the two variables above empty. Whichever you find less fiddly.
GOOGLE_SERVICE_ACCOUNT_JSON=
